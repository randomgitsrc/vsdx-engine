{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-vsdx/schemas/phase7/diagram-ir.schema.json",
  "title": "Diagram IR",
  "description": "What a diagram says: nodes, relations, containers. Deliberately free of layout decisions — geometry is optional and, when omitted, the engine decides.",
  "type": "object",
  "required": [
    "irVersion"
  ],
  "additionalProperties": false,
  "properties": {
    "irVersion": {
      "type": "string",
      "pattern": "^1\\.[0-9]+$",
      "default": "1.0"
    },
    "id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "kind": {
      "type": "string",
      "description": "Semantic family. Drives strategy suggestion, is not a template selector.",
      "enum": [
        "architecture",
        "microservices",
        "workflow",
        "network",
        "org",
        "deployment",
        "hybrid"
      ]
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/node"
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/edge"
      }
    },
    "containers": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/container"
      }
    },
    "metadata": {
      "$ref": "#/$defs/metadata"
    },
    "pages": {
      "type": "array",
      "description": "Pages. When omitted, the top-level nodes/edges/containers form a single implicit page.",
      "items": {
        "$ref": "#/$defs/page"
      }
    },
    "textBlocks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/textBlock"
      }
    },
    "paths": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/path"
      }
    }
  },
  "$defs": {
    "node": {
      "type": "object",
      "required": [
        "id"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "description": "Stable identifier, unique within the IR."
        },
        "label": {
          "type": "string"
        },
        "role": {
          "type": "string",
          "description": "Semantic role; maps to a shape family and theme colour.",
          "enum": [
            "service",
            "database",
            "gateway",
            "queue",
            "client",
            "actor",
            "decision",
            "storage",
            "monitor",
            "external"
          ]
        },
        "containerId": {
          "type": "string"
        },
        "attributes": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "anchor": {
          "$ref": "#/$defs/anchor"
        }
      }
    },
    "anchor": {
      "type": "object",
      "description": "Optional position. Omitting it lets the engine place the node; IR must not become a coordinate list.",
      "additionalProperties": false,
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "mode": {
          "type": "string",
          "enum": [
            "fixed",
            "relative"
          ],
          "default": "fixed"
        }
      }
    },
    "edge": {
      "type": "object",
      "required": [
        "id",
        "from",
        "to"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "from": {
          "type": "string",
          "minLength": 1
        },
        "to": {
          "type": "string",
          "minLength": 1
        },
        "relation": {
          "type": "string",
          "description": "Relationship semantics. 'contains' omits the arrowhead.",
          "enum": [
            "calls",
            "reads",
            "writes",
            "publishes",
            "consumes",
            "depends",
            "contains",
            "flows"
          ]
        },
        "label": {
          "type": "string"
        },
        "fromPort": {
          "type": "string",
          "enum": [
            "left",
            "right",
            "top",
            "bottom",
            "auto"
          ]
        },
        "toPort": {
          "type": "string",
          "enum": [
            "left",
            "right",
            "top",
            "bottom",
            "auto"
          ]
        }
      }
    },
    "container": {
      "type": "object",
      "required": [
        "id"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "enum": [
            "zone",
            "layer",
            "lane",
            "cluster",
            "boundary"
          ]
        },
        "parentId": {
          "type": "string"
        },
        "order": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "description": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "created": {
          "type": "string",
          "format": "date-time"
        },
        "tags": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "page": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string"
        },
        "nodes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/node"
          }
        },
        "edges": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/edge"
          }
        },
        "containers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/container"
          }
        },
        "textBlocks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/textBlock"
          }
        },
        "paths": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/path"
          }
        }
      },
      "anyOf": [
        {
          "required": [
            "nodes"
          ]
        },
        {
          "required": [
            "textBlocks"
          ]
        },
        {
          "required": [
            "paths"
          ]
        }
      ]
    },
    "box": {
      "type": "object",
      "description": "Rectangle in inches: centre plus size.",
      "required": [
        "x",
        "y"
      ],
      "additionalProperties": false,
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "width": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "height": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "textBlock": {
      "type": "object",
      "description": "Standalone text: title, subtitle, caption, legend or note. Not a node — it takes no part in layout, so its box is required.",
      "required": [
        "id",
        "text",
        "box"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "type": "string",
          "enum": [
            "title",
            "subtitle",
            "caption",
            "legend",
            "note"
          ]
        },
        "box": {
          "$ref": "#/$defs/box"
        },
        "align": {
          "type": "string",
          "enum": [
            "left",
            "center",
            "right"
          ]
        },
        "fontSize": {
          "type": "number",
          "minimum": 6,
          "maximum": 72,
          "description": "Explicit points. Overrides the role default."
        },
        "color": {
          "type": "string"
        },
        "font": {
          "type": "string"
        },
        "bold": {
          "type": "boolean"
        },
        "italic": {
          "type": "boolean"
        }
      }
    },
    "path": {
      "type": "object",
      "description": "A shape whose outline is explicit geometry rather than a built-in master. Rows other than MoveTo/LineTo are carried through verbatim.",
      "required": [
        "id",
        "box",
        "rows"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string"
        },
        "box": {
          "$ref": "#/$defs/box"
        },
        "filled": {
          "type": "boolean"
        },
        "stroke": {
          "type": "string"
        },
        "strokeWidth": {
          "type": "number",
          "minimum": 0
        },
        "fill": {
          "type": "string"
        },
        "rows": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/pathRow"
          }
        }
      }
    },
    "pathRow": {
      "type": "object",
      "required": [
        "type",
        "cells"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "MoveTo",
            "LineTo",
            "ArcTo",
            "EllipticalArcTo",
            "SplineKnot",
            "PolylineTo"
          ],
          "description": "The first row must be MoveTo."
        },
        "cells": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "description": "Cell values by name: X, Y, and A/B/C/D for curves."
        }
      }
    }
  },
  "anyOf": [
    {
      "required": [
        "nodes"
      ]
    },
    {
      "required": [
        "pages"
      ]
    }
  ]
}