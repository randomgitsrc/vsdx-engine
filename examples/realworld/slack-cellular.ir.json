      "containerId": "az-b"
    },
    {
      "id": "vit-b",
      "label": "Vitess B",
      "role": "database",
      "containerId": "az-b"
    },
    {
      "id": "fe-c",
      "label": "前端 C",
      "role": "service",
      "containerId": "az-c"
    },
    {
      "id": "vit-c",
      "label": "Vitess C",
      "role": "database",
      "containerId": "az-c"
    }
  ],
  "edges": [
