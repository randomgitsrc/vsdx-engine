      "from": "envoy",
      "to": "fe-a",
      "label": "50%",
      "relation": "calls"
    },
    {
      "id": "e4",
      "from": "envoy",
      "to": "fe-b",
      "label": "50%",
      "relation": "calls"
    },
    {
