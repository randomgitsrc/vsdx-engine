      "id": "edge",
      "label": "边缘层（跨区）",
      "order": 4
    },
    {
      "id": "az-a",
      "label": "us-east-1a",
      "order": 1
    },
    {
      "id": "az-b",
      "label": "us-east-1b",
      "order": 1
    },
    {
      "id": "az-c",
      "label": "us-east-1c",
      "order": 1,
      "status": "drained"
    }
  ],
  "nodes": [
    {
