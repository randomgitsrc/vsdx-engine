    { "id": "g6", "from": "order",  "to": "redis",  "relation": "reads",     "label": "cache" },
    { "id": "g7", "from": "order",  "to": "kafka",  "relation": "publishes", "label": "event" },
    { "id": "g8", "from": "kafka",  "to": "worker", "relation": "consumes",  "label": "consume" },
    { "id": "g9", "from": "kafka",  "to": "mon",    "relation": "depends",   "label": "metrics" }
