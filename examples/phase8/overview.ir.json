    { "id": "pg",     "label": "PostgreSQL",          "role": "database", "containerId": "infra" },
    { "id": "redis",  "label": "Redis 缓存",          "role": "storage",  "containerId": "infra" },
    { "id": "kafka",  "label": "Kafka",               "role": "queue",    "containerId": "infra" },
