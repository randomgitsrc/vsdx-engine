        {
          "id": "e5",
          "from": "payment",
          "to": "pick-pack",
          "kind": "rightAngle",
          "label": "已授权",
          "endArrow": "triangle",
          "lineColor": "#507E32",
          "fromPort": "bottom",
          "toPort": "top",
          "labelPosition": 0.5,
          "waypoints": [
            {
              "x": 11.0,
              "y": 3.9
            },
            {
              "x": 2.2,
              "y": 3.9
            }
          ]
