{
  "id": "order-fulfilment-workflow",
  "name": "订单履约审批流程",
  "type": "workflow",
  "modelVersion": "1.0",
  "pageSize": {
    "width": 14.2,
    "height": 10.6,
    "unit": "inches"
  },
  "orientation": "landscape",
  "background": "#FFFFFF",
  "style": {
    "font": "Microsoft YaHei",
