        {
          "id": "e9",
          "from": "reject",
          "to": "notify",
          "kind": "rightAngle",
          "label": "取消 cancel",
          "endArrow": "triangle",
          "lineColor": "#999999",
          "linePattern": 2,
          "fromPort": "bottom",
          "toPort": "left",
          "waypoints": [
            {
              "x": 7.6,
              "y": 4.4
            },
            {
              "x": 7.05,
              "y": 4.4
            },
            {
              "x": 7.05,
              "y": 2.2
            }
          ]
        }
